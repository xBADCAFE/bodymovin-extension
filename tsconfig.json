{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "removeComments": true,
    "lib": ["ES5"],
    "rootDir": "./ts",
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["ts/**/*.ts", "ts/**/*.d.ts"]
}
